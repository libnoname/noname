{
	"exclude": ["**/dist", "**/output", "**/node_modules", "apps/mobile/android", "apps/mobile/ios", ".claude"],
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"strict": true,
		"noImplicitAny": false,
		"allowSyntheticDefaultImports": true
	}
}
